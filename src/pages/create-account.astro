---
import AppLayout from "../layouts/AppLayout.astro";
import { appPath } from "../lib/routes";
---

<AppLayout title="Create account | LLMCenter">
  <section class="page-head">
    <h1>Create account</h1>
    <p class="lead">Start here before charging credits or creating API keys.</p>
  </section>

  <form class="form panel" data-create-form>
    <div class="field">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="new-password" required minlength="8" />
    </div>
    <div class="actions">
      <button class="button" type="submit">Create account</button>
      <a class="button secondary" href={appPath("/login")}>I already have an account</a>
    </div>
    <p class="status" data-status></p>
  </form>

    <script>
      import { supabase } from "../lib/supabase";
      import { appPath } from "../lib/routes";

    const form = document.querySelector("[data-create-form]");
    const status = document.querySelector("[data-status]");

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!(form instanceof HTMLFormElement)) return;

      status?.classList.remove("error");
      if (status) status.textContent = "Creating account...";

      const formData = new FormData(form);
      const email = String(formData.get("email") ?? "");
      const password = String(formData.get("password") ?? "");

      const result = await supabase.auth.signUp({
        email,
        password,
        options: {
          emailRedirectTo: `${window.location.origin}${appPath("/dashboard")}`,
        },
      });

      if (result.error) {
        status?.classList.add("error");
        if (status) status.textContent = result.error.message;
        return;
      }

      if (result.data.session) {
        window.location.href = appPath("/dashboard");
        return;
      }

      if (status) status.textContent = "Account created. Check your email to confirm, then login.";
    });
  </script>
</AppLayout>
