---
import AppLayout from "../layouts/AppLayout.astro";
import { appPath } from "../lib/routes";
---

<AppLayout title="Dashboard | LLMCenter">
  <section class="page-head">
    <h1>Dashboard</h1>
    <p class="lead">Balance and API keys for the signed-in user.</p>
  </section>

  <section class="grid">
    <div class="panel">
      <h2>Balance</h2>
      <p class="price" data-balance>$0.00</p>
      <a class="button" href={appPath("/charge")}>Charge</a>
    </div>
    <div class="panel">
      <h2>API keys</h2>
      <p class="muted" data-key-count>0 active keys</p>
      <a class="button secondary" href={appPath("/new-api")}>New key</a>
    </div>
    <div class="panel">
      <h2>Status</h2>
      <p class="muted" data-user-status>Checking session...</p>
    </div>
  </section>

  <section class="panel" style="margin-top: 16px;">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Prefix</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody data-keys>
        <tr><td colspan="3" class="muted">No keys loaded.</td></tr>
      </tbody>
    </table>
  </section>

    <script>
      import { supabase } from "../lib/supabase";
      import { appPath } from "../lib/routes";

    const balance = document.querySelector("[data-balance]");
    const keyCount = document.querySelector("[data-key-count]");
    const userStatus = document.querySelector("[data-user-status]");
    const keyBody = document.querySelector("[data-keys]");

    const { data } = await supabase.auth.getSession();
    if (!data.session) {
      window.location.href = appPath("/login");
    } else {
      if (userStatus) userStatus.textContent = data.session.user.email ?? data.session.user.id;

      const { data: profile } = await supabase
        .from("profiles")
        .select("balance_cents")
        .eq("id", data.session.user.id)
        .maybeSingle();

      if (balance) {
        const cents = profile?.balance_cents ?? 0;
        balance.textContent = new Intl.NumberFormat("en-US", {
          style: "currency",
          currency: "USD",
        }).format(cents / 100);
      }

      const { data: keys } = await supabase
        .from("api_keys")
        .select("name,key_prefix,created_at")
        .eq("user_id", data.session.user.id)
        .is("revoked_at", null)
        .order("created_at", { ascending: false });

      if (keyCount) keyCount.textContent = `${keys?.length ?? 0} active keys`;
      if (keyBody) {
        keyBody.innerHTML = "";
        if (!keys?.length) {
          keyBody.innerHTML = '<tr><td colspan="3" class="muted">No active keys.</td></tr>';
        } else {
          for (const key of keys) {
            const row = document.createElement("tr");
            row.innerHTML = `<td>${key.name}</td><td>${key.key_prefix}</td><td>${new Date(key.created_at).toLocaleString()}</td>`;
            keyBody.append(row);
          }
        }
      }
    }
  </script>
</AppLayout>
